rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================
    // صور منتجات المتجر (حسابات الألعاب)
    // =========================
    //
    // القراءة عامة حتى تظهر الصور في المتجر لكل المستخدمين.
    // الكتابة مسموحة فقط لصاحب المجلد (نفس uid المستخدم المسجّل دخوله)،
    // وبحد أقصى 5 ميجابايت لكل صورة، ونوع الملف لازم يكون صورة فعلاً.
    match /product_images/{uid}/{allImages=**} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // منع أي وصول لأي مسار آخر بشكل افتراضي
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
